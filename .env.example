# PostgreSQL 접속 문자열
# 로컬:  docker compose up -d 로 띄운 컨테이너 기준
# Neon:  postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/melody_hq?sslmode=require
DATABASE_URL="postgresql://melody:melody@localhost:5432/melody_hq?schema=public"

# 세션 JWT 서명 키 (openssl rand -base64 32 로 생성)
AUTH_SECRET="change-me-to-a-random-32-byte-string"

# 초기 관리자 계정 (npm run db:seed 시 생성)
SEED_ADMIN_EMAIL="admin@melody.kr"
SEED_ADMIN_PASSWORD="melody1234"

# 반복 업무 생성 크론 보호용 시크릿 (Vercel Cron 이 Bearer 토큰으로 전송)
CRON_SECRET="change-me-too"
