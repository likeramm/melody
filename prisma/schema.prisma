// MELODY 통합 학원 관리 플랫폼 (HQ) — 데이터 모델
// 기획서 4장 ERD 초안을 관계형 스키마로 구체화한 것입니다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// 1. 계정 및 권한
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN // 시스템 관리자
  DIRECTOR // 원장
  TEACHER // 강사
  STAFF // 운영/마케팅/IT 담당자
  PARENT // 학부모 (학부모 포털 전용)
}

enum Department {
  OPERATIONS // 운영
  MARKETING // 마케팅
  IT // IT
  ACADEMIC // 학사
  MANAGEMENT // 경영
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String
  phone        String?
  role         Role        @default(STAFF)
  department   Department?
  isActive     Boolean     @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  assignedTasks    Task[]           @relation("TaskAssignee")
  createdTasks     Task[]           @relation("TaskCreator")
  approvedTasks    Task[]           @relation("TaskApprover")
  consultations    Consultation[]   @relation("ConsultationCounselor")
  assessments      Assessment[]     @relation("AssessmentAssessor")
  homeroomStudents Student[]        @relation("HomeroomTeacher")
  guardianOf       Guardian[]
  lessonsCreated   Lesson[]         @relation("LessonAuthor")
  promptTemplates  PromptTemplate[] @relation("PromptAuthor")
  notes            StudentNote[]    @relation("NoteAuthor")

  @@index([role])
  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────
// 2. 업무 대시보드 (Master Task System)
// ─────────────────────────────────────────────────────────────

enum TaskStatus {
  TODO // 대기
  IN_PROGRESS // 진행중
  NEED_APPROVAL // 결재 대기
  DONE // 완료
  ARCHIVED // 보관
}

enum TaskPriority {
  URGENT // 긴급
  HIGH // 높음
  NORMAL // 보통
  LOW // 낮음
}

enum RecurrenceRule {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(NORMAL)
  dueDate     DateTime?
  completedAt DateTime?
  relatedLink String?
  category    String? // 예: 문의 확인 / 주간 리뷰 / 운영지표 점검

  assigneeId   String?
  assignee     User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?     @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById String?
  approvedBy   User?     @relation("TaskApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  // 반복 업무 자동 생성용.
  // isTemplate=true 인 Task 는 리스트에 뜨지 않는 "생성 규칙"이며,
  // 스케줄러가 이를 복제해 실제 Task 를 만들어냅니다.
  recurrence RecurrenceRule @default(NONE)
  isTemplate Boolean        @default(false)
  templateId String? // 이 Task 를 만들어낸 템플릿 Task 의 id
  periodKey  String? // 생성 주기 식별자 (예: 2026-08-26 / 2026-W35 / 2026-08)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 같은 템플릿이 같은 주기에 두 번 생성되는 것을 DB 레벨에서 차단합니다.
  @@unique([templateId, periodKey])
  @@index([assigneeId, status])
  @@index([dueDate])
  @@index([status, priority])
  @@index([isTemplate, recurrence])
}

// ─────────────────────────────────────────────────────────────
// 3. 학생 CRM 및 입학 파이프라인
// ─────────────────────────────────────────────────────────────

enum AdmissionStage {
  INQUIRY // 문의
  CONSULTATION // 예약/상담
  ASSESSMENT_COMPLETED // 시험 완료
  REGISTERED // 등록
  WITHDRAWN // 이탈/보류
}

enum EnglishLevel {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED
}

model Student {
  id           String         @id @default(cuid())
  name         String
  nameEn       String?
  birthDate    DateTime?
  school       String?
  grade        String? // 예: 초5 / 중2
  phone        String?
  englishLevel EnglishLevel?
  stage        AdmissionStage @default(INQUIRY)
  stageOrder   Int            @default(0) // 칸반 보드 내 정렬 순서
  currentGoal  String? // 현재 학습 목표 (Current Goal)
  memo         String?
  enrolledAt   DateTime? // 등록 확정일
  isActive     Boolean        @default(true)

  homeroomTeacherId String?
  homeroomTeacher   User?       @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  classGroupId      String?
  classGroup        ClassGroup? @relation(fields: [classGroupId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardians     Guardian[]
  consultations Consultation[]
  assessments   Assessment[]
  attendances   Attendance[]
  notes         StudentNote[]

  @@index([stage, stageOrder])
  @@index([isActive])
  @@index([homeroomTeacherId])
  @@index([name])
}

model ClassGroup {
  id        String   @id @default(cuid())
  name      String   @unique // 예: Intermediate A
  schedule  String? // 예: 월/수/금 17:00
  capacity  Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  curriculumId String?
  curriculum   Curriculum? @relation(fields: [curriculumId], references: [id], onDelete: SetNull)

  students    Student[]
  attendances Attendance[]
}

enum GuardianRelation {
  MOTHER
  FATHER
  OTHER
}

// 학부모 ↔ 학생 연결. 학부모 포털의 접근 권한은 전적으로 이 테이블을 근거로 판정합니다.
model Guardian {
  id        String           @id @default(cuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  userId    String? // 포털 계정 (Role.PARENT). 계정 미발급 시 null
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  phone     String?
  email     String?
  relation  GuardianRelation @default(MOTHER)
  isPrimary Boolean          @default(true)
  createdAt DateTime         @default(now())

  @@unique([studentId, userId])
  @@index([studentId])
  @@index([userId])
}

// 학부모 요청사항 및 내부 상담 메모
model StudentNote {
  id              String    @id @default(cuid())
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  authorId        String?
  author          User?     @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body            String
  isParentRequest Boolean   @default(false)
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([studentId, createdAt])
}

enum AttendanceStatus {
  PRESENT // 출석
  LATE // 지각
  ABSENT // 결석
  EXCUSED // 사유결석
}

model Attendance {
  id           String           @id @default(cuid())
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classGroupId String?
  classGroup   ClassGroup?      @relation(fields: [classGroupId], references: [id], onDelete: SetNull)
  date         DateTime         @db.Date
  status       AttendanceStatus @default(PRESENT)
  note         String?
  createdAt    DateTime         @default(now())

  @@unique([studentId, date])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────
// 4. 상담 & 예약 파이프라인
// ─────────────────────────────────────────────────────────────

enum ConsultationStatus {
  PENDING // 대기 (폼 접수 직후)
  CONFIRMED // 예약 확정 (캘린더 등록됨)
  COMPLETED // 상담 완료
  NO_SHOW // 미방문
  CANCELLED // 취소
}

enum ConsultationType {
  NEW_INQUIRY // 신규 문의
  ADMISSION_TEST // 입학 시험
  PROGRESS_REVIEW // 정기 학습 상담
  COMPLAINT // 불만/요청 상담
  RE_ENROLLMENT // 재등록 상담
}

enum AdmissionLikelihood {
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

model Consultation {
  id String @id @default(cuid())

  // 접수 시점에는 아직 Student 레코드가 없을 수 있으므로
  // 신청 폼에 적힌 학생 정보를 스냅샷으로 함께 보관합니다.
  studentId            String?
  student              Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  applicantStudentName String
  applicantGrade       String?
  applicantLevel       EnglishLevel?

  parentName  String
  parentPhone String
  parentEmail String?

  type        ConsultationType   @default(NEW_INQUIRY)
  status      ConsultationStatus @default(PENDING)
  requestedAt DateTime           @default(now()) // 폼 접수 시각
  preferredAt DateTime? // 학부모 희망 시간
  scheduledAt DateTime? // 확정된 상담 시각
  durationMin Int                @default(30)

  // 상담 결과 (CRM 기록)
  summary             String?
  recommendedProgram  String?
  admissionLikelihood AdmissionLikelihood @default(UNKNOWN)
  followUpAt          DateTime?

  counselorId String?
  counselor   User?   @relation("ConsultationCounselor", fields: [counselorId], references: [id], onDelete: SetNull)

  // Google Calendar 2-way 동기화용
  googleEventId String?   @unique
  syncedAt      DateTime?

  source    String? // 유입 경로: homepage / phone / walk-in / referral
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([requestedAt])
  @@index([followUpAt])
  @@index([studentId])
}

// ─────────────────────────────────────────────────────────────
// 5. 평가 (Assessment)
// ─────────────────────────────────────────────────────────────

enum AssessmentType {
  ADMISSION // 입학 시험
  MONTHLY // 월간 평가
  MIDTERM // 중간 평가
  FINAL // 기말 평가
  MOCK // 모의고사
}

model Assessment {
  id        String         @id @default(cuid())
  studentId String
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type      AssessmentType @default(MONTHLY)
  takenAt   DateTime

  // 영역별 점수 (0~100). 미응시 영역은 null 로 두어 차트에서 제외합니다.
  reading    Int?
  listening  Int?
  speaking   Int?
  writing    Int?
  grammar    Int?
  vocabulary Int?

  totalScore     Int? // 환산 총점. null 이면 응시 영역 평균으로 계산합니다.
  teacherComment String?
  parentSharedAt DateTime? // 학부모 포털 공개 시각. null 이면 비공개

  assessorId String?
  assessor   User?   @relation("AssessmentAssessor", fields: [assessorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, takenAt])
  @@index([type])
}

// ─────────────────────────────────────────────────────────────
// 6. 커리큘럼 & 레슨 플랜
// ─────────────────────────────────────────────────────────────

model Curriculum {
  id          String        @id @default(cuid())
  title       String // 예: 2026 Spring Intermediate
  semester    String // 예: 2026-1
  level       EnglishLevel?
  description String?
  isActive    Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons     Lesson[]
  classGroups ClassGroup[]

  @@unique([semester, title])
  @@index([isActive])
}

model Lesson {
  id           String     @id @default(cuid())
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  week        Int // 주차
  topic       String
  objectives  String? // 학습 목표
  vocabulary  String[] // 필수 어휘
  homework    String?
  materialUrl String? // 자료 링크
  notes       String?

  authorId String?
  author   User?   @relation("LessonAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([curriculumId, week])
  @@index([curriculumId, week])
}

// ─────────────────────────────────────────────────────────────
// 7. AI 프롬프트 라이브러리
// ─────────────────────────────────────────────────────────────

enum PromptCategory {
  WORKSHEET // 워크시트 생성
  DISCUSSION // 토론 질문
  MARKETING // 마케팅 카피
  ASSESSMENT // 평가 문항
  PARENT_REPORT // 학부모 리포트
  ETC
}

model PromptTemplate {
  id          String         @id @default(cuid())
  title       String
  category    PromptCategory @default(ETC)
  body        String // {{topic}}, {{level}} 형태의 치환 변수를 포함한 본문
  variables   String[] // 치환 변수 목록
  description String?
  useCount    Int            @default(0)
  isActive    Boolean        @default(true)

  authorId String?
  author   User?   @relation("PromptAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, isActive])
}
